{
  "name": "emulators",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "gba": "npm run start --workspace apps/gba",
    "nds": "npm run start --workspace apps/nds",
    "threeds": "npm run start --workspace apps/threeds",
    "android:gba": "npm run android --workspace apps/gba",
    "android:nds": "npm run android --workspace apps/nds",
    "android:threeds": "npm run android --workspace apps/threeds",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
