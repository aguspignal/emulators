{
  "expo": {
    "name": "GBA Emulator",
    "slug": "gba",
    "scheme": "gba",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.aguspignal.gba",
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "db93b660-e91f-40d0-9cf6-7d8d1fd3200b"
      }
    },
    "owner": "aguspignal",
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1c1c22",
          "image": "./assets/splash-icon.png",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1c1c22"
          },
          "imageWidth": 200
        }
      ]
    ]
  }
}
