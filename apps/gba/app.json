{
  "expo": {
    "name": "GBA Emulator",
    "slug": "gba",
    "scheme": "gba",
    "version": "1.1.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.aguspignal.gba",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "*/*" }]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [{ "scheme": "content", "mimeType": "application/*" }]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [{ "scheme": "content" }]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.gba"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\..*\\\\.gba"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.gbc"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\..*\\\\.gbc"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.gb"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\..*\\\\.gb"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "scheme": "file", "pathPattern": ".*\\\\.gba" },
            { "scheme": "file", "pathPattern": ".*\\\\..*\\\\.gba" },
            { "scheme": "file", "pathPattern": ".*\\\\.gbc" },
            { "scheme": "file", "pathPattern": ".*\\\\..*\\\\.gbc" },
            { "scheme": "file", "pathPattern": ".*\\\\.gb" },
            { "scheme": "file", "pathPattern": ".*\\\\..*\\\\.gb" }
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "db93b660-e91f-40d0-9cf6-7d8d1fd3200b"
      }
    },
    "owner": "aguspignal",
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1c1c22",
          "image": "./assets/splash-icon.png",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1c1c22"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Tourney",
                "fontDefinitions": [
                  { "path": "../../packages/ui/assets/fonts/Tourney-Black.ttf", "weight": 900 }
                ]
              },
              {
                "fontFamily": "Roboto",
                "fontDefinitions": [
                  { "path": "../../packages/ui/assets/fonts/Roboto-Regular.ttf", "weight": 400 },
                  { "path": "../../packages/ui/assets/fonts/Roboto-SemiBold.ttf", "weight": 600 }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
