{
  "expo": {
    "name": "NDS Emulator",
    "slug": "nds",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.aguspignal.nds",
      "adaptiveIcon": {
        "backgroundColor": "#101014",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Tourney",
                "fontDefinitions": [
                  { "path": "../../packages/ui/assets/fonts/Tourney-Black.ttf", "weight": 900 }
                ]
              },
              {
                "fontFamily": "Roboto",
                "fontDefinitions": [
                  { "path": "../../packages/ui/assets/fonts/Roboto-Regular.ttf", "weight": 400 },
                  { "path": "../../packages/ui/assets/fonts/Roboto-SemiBold.ttf", "weight": 600 }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
