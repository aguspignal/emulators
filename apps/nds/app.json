{
  "expo": {
    "name": "NDS Emulator",
    "slug": "nds",
    "version": "1.2.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.aguspignal.nds",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "*/*"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/*"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "content"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.nds"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\..*\\\\.nds"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "file",
              "pathPattern": ".*\\\\.nds"
            },
            {
              "scheme": "file",
              "pathPattern": ".*\\\\..*\\\\.nds"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Tourney",
                "fontDefinitions": [
                  {
                    "path": "../../packages/ui/assets/fonts/Tourney-Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "Roboto",
                "fontDefinitions": [
                  {
                    "path": "../../packages/ui/assets/fonts/Roboto-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "../../packages/ui/assets/fonts/Roboto-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1c1c22",
          "image": "./assets/splash-icon.png",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1c1c22"
          },
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "46a775ea-8a2b-44a3-b948-e6025307bcc2"
      }
    }
  }
}
